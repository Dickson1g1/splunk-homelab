-- ============================================================
-- DETECTION RULE 5: Privilege Escalation Attempts
-- ============================================================
-- Description : Detects three escalation signals:
--               (A) New user added to privileged group
--               (B) Standard user running admin-level commands
--               (C) Audit policy or security log cleared
-- MITRE ATT&CK: T1078 - Valid Accounts / T1098 - Account Manipulation
--               T1562.002 - Disable Windows Event Logging
-- NIST Phase  : Detect → Respond (immediate)
-- Severity    : Critical
-- Schedule    : Run every 5 minutes, look back 5 minutes
-- ============================================================


-- ============================================================
-- QUERY A: User added to privileged group
-- (EventCode 4728 = added to security-enabled global group)
-- (EventCode 4732 = added to security-enabled local group)
-- (EventCode 4756 = added to security-enabled universal group)
-- ============================================================

index=windows_events sourcetype="WinEventLog:Security"
  (EventCode=4728 OR EventCode=4732 OR EventCode=4756)
| eval event_description = case(
    EventCode="4728", "User added to global privileged group",
    EventCode="4732", "User added to local privileged group",
    EventCode="4756", "User added to universal privileged group"
  )
| eval is_high_value_group = if(
    match(group_name, "(?i)Domain Admins|Administrators|Enterprise Admins|Schema Admins|Account Operators|Backup Operators"),
    "YES - CRITICAL GROUP", "NO"
  )
| eval severity    = if(is_high_value_group="YES - CRITICAL GROUP", "CRITICAL", "HIGH")
| eval mitre_tactic    = "Privilege Escalation / Persistence"
| eval mitre_technique = "T1098 - Account Manipulation"
| eval recommended_action = "IMMEDIATE: Verify change was authorized via change management. If unauthorized, remove from group, reset password, and initiate IR process."
| table
    _time, user, group_name, src_user, ComputerName,
    event_description, is_high_value_group,
    severity, mitre_tactic, mitre_technique, recommended_action


