-- ============================================================
-- DETECTION RULE 4: Port Scan Detection
-- ============================================================
-- Description : Detects a single source IP hitting 15+
--               distinct destination ports within 2 minutes.
--               Indicative of nmap or automated scanning tools.
-- MITRE ATT&CK: T1046 - Network Service Discovery (Discovery)
-- NIST Phase  : Detect
-- Severity    : Medium → High (if targeting internal hosts)
-- Schedule    : Run every 2 minutes, look back 2 minutes
-- Source      : Web access logs / network logs
-- ============================================================

index=web_logs OR index=windows_events
| bucket _time span=2m
| stats
    dc(dest_port)        AS unique_ports_hit,
    values(dest_port)    AS ports_scanned,
    dc(dest_ip)          AS unique_targets,
    values(dest_ip)      AS targeted_hosts,
    count                AS total_connections,
    first(_time)         AS scan_start
  BY src_ip, _time
| where unique_ports_hit >= 15
| eval severity = case(
    unique_ports_hit >= 100, "CRITICAL",
    unique_ports_hit >= 50,  "HIGH",
    unique_ports_hit >= 15,  "MEDIUM"
  )
| eval scan_type = case(
    unique_ports_hit >= 1000, "Full port scan (all ports)",
    unique_ports_hit >= 100,  "Service discovery scan",
    unique_ports_hit >= 15,   "Targeted port scan"
  )
| eval high_risk_ports = if(
    match(mvjoin(ports_scanned, ","), "22|23|3389|445|139|135|1433|3306|5432"),
    "YES - sensitive services targeted", "NO"
  )
| eval mitre_tactic    = "Discovery"
| eval mitre_technique = "T1046 - Network Service Discovery"
| eval recommended_action = "Block src_ip at perimeter firewall. Check IDS/IPS for follow-on exploitation attempts. If internal IP, investigate compromised host."
| table
    src_ip,
    unique_ports_hit,
    scan_type,
    high_risk_ports,
    unique_targets,
    targeted_hosts,
    severity,
    mitre_tactic,
    mitre_technique,
    recommended_action,
    scan_start
| sort - unique_ports_hit


-- ============================================================
-- HOW TO SAVE AS AN ALERT IN SPLUNK
-- ============================================================
-- Title     : Port Scan Activity Detected
-- Schedule  : Run every 2 minutes
-- Time range: Last 2 minutes
-- Trigger   : Number of Results > 0
-- Severity  : Medium
-- ============================================================


-- ============================================================
-- HIGH-RISK PORTS REFERENCE
-- ============================================================
-- 22    SSH          (remote access)
-- 23    Telnet       (unencrypted remote access)
-- 445   SMB          (lateral movement, EternalBlue)
-- 3389  RDP          (remote desktop)
-- 135   RPC          (Windows services)
-- 139   NetBIOS      (legacy Windows sharing)
-- 1433  MS SQL       (database)
-- 3306  MySQL        (database)
-- 5432  PostgreSQL   (database)
-- ============================================================
